{
  "name": "blog-editor",
  "version": "0.1.5",
  "description": "A desktop app that sets up and runs a blog for a non-technical person",
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pack:mac": "npm run build && electron-builder --mac --publish never",
    "pack:win": "npm run build && electron-builder --win --publish never",
    "smoke": "electron-vite build && BLOG_EDITOR_SMOKE=$PWD/out/smoke.png electron ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "electron-updater": "^6.8.9",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^44.0.0",
    "electron-builder": "^25.0.0",
    "electron-vite": "^4.0.0",
    "happy-dom": "^21.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
